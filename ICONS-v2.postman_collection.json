{
	"info": {
		"name": "ICONS v2 API",
		"description": "Inventario completo de servicios del backend ICONS v2 — PlastyFreddy.\n\nBase URL: {{baseUrl}}\nAuth: Bearer JWT",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "accessToken", "value": "" },
		{ "key": "refreshToken", "value": "" }
	],
	"item": [
		{
			"name": "01 — Auth",
			"description": "Autenticación, tokens y reset de contraseña (pública)",
			"item": [
				{
					"name": "Login",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"if (pm.response.code === 200) {",
								"    var json = pm.response.json();",
								"    pm.collectionVariables.set('accessToken', json.accessToken);",
								"    pm.collectionVariables.set('refreshToken', json.refreshToken);",
								"}"
							]
						}
					}],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"url": "{{baseUrl}}/auth/login",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant\": \"plastyfreddy\",\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
						}
					}
				},
				{
					"name": "Refresh Token",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"if (pm.response.code === 200) {",
								"    var json = pm.response.json();",
								"    pm.collectionVariables.set('accessToken', json.accessToken);",
								"    pm.collectionVariables.set('refreshToken', json.refreshToken);",
								"}"
							]
						}
					}],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"url": "{{baseUrl}}/auth/refresh",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/logout",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						}
					}
				},
				{
					"name": "Logout All Sessions",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/logout-all"
					}
				},
				{
					"name": "Password Reset — Request Code",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"url": "{{baseUrl}}/auth/password-reset/request",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant\": \"plastyfreddy\",\n  \"email\": \"admin@plastyfreddy.com\"\n}"
						}
					}
				},
				{
					"name": "Password Reset — Confirm",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"url": "{{baseUrl}}/auth/password-reset/confirm",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant\": \"plastyfreddy\",\n  \"email\": \"admin@plastyfreddy.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPass123!\"\n}"
						}
					}
				},
				{
					"name": "Get Current User (me)",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/auth/me"
					}
				}
			]
		},
